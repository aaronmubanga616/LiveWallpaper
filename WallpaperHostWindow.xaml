<Window x:Class="LiveWallpaper.WallpaperHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="800"
        Height="450"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Background="Black"
        Opacity="0">
    <Grid Background="Black">
        <MediaElement x:Name="WallpaperPlayer"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      MediaOpened="WallpaperPlayer_MediaOpened"
                      MediaEnded="WallpaperPlayer_MediaEnded"
                      MediaFailed="WallpaperPlayer_MediaFailed" />
    </Grid>
</Window>
