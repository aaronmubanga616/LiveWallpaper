<Window x:Class="LiveWallpaper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveWallpaper"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        Background="#0A0F18"
        Foreground="#EDF2FA"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111A27" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#233044" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A0B4" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6EE7C2" />

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF0F8" />
            <Setter Property="Background" Value="#1A2636" />
            <Setter Property="BorderBrush" Value="#2A3A50" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#223248" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3B526E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#082018" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="16,13" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EAF0F8" />
            <Setter Property="Background" Value="#0D1520" />
            <Setter Property="BorderBrush" Value="#2A3A50" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="13" Background="#16372F" Margin="0,0,13,0">
                    <TextBlock Text="LW" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LiveWallpaper" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="A little motion for your desktop" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#111A27" BorderBrush="#233044" BorderThickness="1"
                    CornerRadius="18" Padding="13,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator" Width="7" Height="7" Fill="#8190A3" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="READY TO SET UP" FontSize="10" FontWeight="Bold"
                               Foreground="#A7B3C3" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#05080D" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="18" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="PreviewPlayer" Stretch="UniformToFill" LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual" MediaOpened="PreviewPlayer_MediaOpened"
                                      MediaEnded="PreviewPlayer_MediaEnded" MediaFailed="PreviewPlayer_MediaFailed" />
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16"
                                Background="#B30A0F18" CornerRadius="12" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                                <TextBlock Text="VIDEO PREVIEW" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="330" Margin="24" Visibility="Visible">
                            <Border Width="58" Height="58" CornerRadius="18" Background="#182638" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="▶" FontSize="20" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0" />
                            </Border>
                            <TextBlock x:Name="PreviewMessage" Text="Choose a video to preview it here"
                                       FontSize="17" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Text="MP4 and other Windows-supported video formats" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,16,0,0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayPauseButton" Content="▶" Width="36" Height="36" Padding="0"
                                    Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False" Click="PlayPauseButton_Click" />
                            <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                                    Margin="14,0" VerticalAlignment="Center" IsMoveToPointEnabled="True" IsEnabled="False" />
                            <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="LoopCheckBox" Content="Loop" IsChecked="True" Foreground="#C8D1DE"
                                      FontSize="12" VerticalAlignment="Center"
                                      Checked="WallpaperOptions_Changed" Unchecked="WallpaperOptions_Changed" />
                            <TextBlock Grid.Column="2" Text="VOLUME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,9,0" />
                            <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="1" Value="0.65"
                                    VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="21">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="WALLPAPER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Set the scene" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,19" />

                        <TextBlock Text="VIDEO FILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                        <Border Background="#0D1520" BorderBrush="#26364B" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,8,0,10">
                            <StackPanel>
                                <TextBlock x:Name="VideoNameText" Text="No video selected" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="VideoPathText" Text="Choose a video from your computer" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Button Content="Choose video" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                Click="ChooseVideoButton_Click" />

                        <TextBlock Text="DISPLAY STYLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,22,0,8" />
                        <ComboBox x:Name="DisplayStyleComboBox" SelectedIndex="0" Height="38"
                                  SelectionChanged="DisplayStyleComboBox_SelectionChanged">
                            <ComboBoxItem Content="Fill screen" />
                            <ComboBoxItem Content="Fit entire video" />
                            <ComboBoxItem Content="Stretch to screen" />
                        </ComboBox>

                        <CheckBox x:Name="MuteWallpaperCheckBox" Content="Mute wallpaper audio" IsChecked="True"
                                  Foreground="#C8D1DE" FontSize="12" Margin="0,18,0,0"
                                  Checked="WallpaperOptions_Changed" Unchecked="WallpaperOptions_Changed" />
                        <TextBlock Text="The preview uses the volume controls. Wallpaper audio is muted by default."
                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="22,5,0,0" />

                        <Button x:Name="ApplyButton" Content="Apply to desktop" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,24,0,0" IsEnabled="False" Click="ApplyButton_Click" />
                        <Button x:Name="StopButton" Content="Stop wallpaper" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,9,0,0" IsEnabled="False" Click="StopButton_Click" />

                        <Border Background="#0D1520" CornerRadius="10" Padding="11" Margin="0,18,0,0">
                            <TextBlock Text="The app stays open while the wallpaper is running. Closing it restores your normal desktop background."
                                       FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
